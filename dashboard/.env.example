# Leave all three unset to run the dashboard in demo mode (seeded mock data,
# no backend required — see src/lib/supabase.ts).
#
# Set all three to point the dashboard at a real Supabase project and the
# deployed dashboard-api Edge Function.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — defaults to `${VITE_SUPABASE_URL}/functions/v1/dashboard-api`
VITE_DASHBOARD_API_URL=
